---
import { Image } from "astro:assets";
import type { Lang, TimelineEvent } from "../../data/timeline";

interface Props {
    event: TimelineEvent;
    lang: Lang;
    reversed?: boolean;
}

const { event, lang, reversed = false } = Astro.props;
---

<li class="relative pb-20 pl-8 last:pb-0 md:pl-14 lg:pb-28">
    <!-- Timeline dot -->
    <span
        class="absolute -left-[7px] top-2 h-[13px] w-[13px] rounded-full border-[3px] border-[var(--surface)] bg-[var(--accent)]"
        aria-hidden="true"></span>

    <article class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <!-- Text content -->
        <div class:list={["min-w-0", reversed && "lg:order-2"]}>
            <p
                class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--accent)]"
            >
                {event.date[lang]}
            </p>

            <p
                class="mt-4 text-6xl font-bold tracking-tight opacity-15 md:text-7xl"
            >
                {event.year}
            </p>

            <h3 class="mt-4 text-2xl font-semibold tracking-tight md:text-3xl">
                {event.title[lang]}
            </h3>

            <p class="mt-6 text-base leading-8 opacity-85 md:text-lg">
                {event.description[lang]}
            </p>

            <p class="mt-5 text-base leading-8 opacity-70">
                {event.detail[lang]}
            </p>
        </div>

        <!-- Image -->
        <div class:list={["min-w-0", reversed && "lg:order-1"]}>
            <div
                class="aspect-square overflow-hidden rounded-lg bg-[var(--bg)]"
            >
                <Image
                    src={event.image}
                    alt={`${event.title[lang]} – ${event.year}`}
                    width={900}
                    widths={[360, 720, 900]}
                    sizes="(min-width: 1024px) 45vw, 100vw"
                    loading="lazy"
                    class="h-full w-full object-cover grayscale transition-transform duration-500 hover:scale-105"
                />
            </div>
        </div>
    </article>
</li>
