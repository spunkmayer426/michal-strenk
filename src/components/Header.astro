---
import Container from "./Container.astro";
import ThemeSwitcher from "./ThemeSwitcher.vue";

interface Props {
    lang?: "sk" | "en";
}

const { lang = "sk" } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const skUrl = `${base}/`;
const enUrl = `${base}/en/`;

const isEnglish = lang === "en";
---

<header
    class="sticky top-0 z-50 border-b border-[var(--text)]/10 bg-[var(--bg)]/95 backdrop-blur-md"
>
    <Container class="flex min-h-20 items-center justify-between gap-4">
        <a
            href={isEnglish ? enUrl : skUrl}
            class="flex flex-col leading-tight"
            aria-label={isEnglish
                ? "Michael Strank – Home"
                : "Michal Strenk – Domov"}
        >
            <span class="text-lg font-bold tracking-wide">
                {isEnglish ? "MICHAEL STRANK" : "MICHAL STRENK"}
            </span>
            <span
                class="text-[10px] uppercase tracking-[0.2em] text-[var(--accent)]"
            >
                {isEnglish ? "Legacy & Remembrance" : "Odkaz a pamiatka"}
            </span>
        </a>

        <nav
            aria-label={isEnglish ? "Main navigation" : "Hlavná navigácia"}
            class="flex items-center gap-3 sm:gap-6"
        >
            <div class="hidden items-center gap-6 text-sm font-medium md:flex">
                <a
                    href="#story"
                    class="transition-colors hover:text-[var(--accent)]"
                >
                    {isEnglish ? "Story" : "Príbeh"}
                </a>
                <a
                    href="#history"
                    class="transition-colors hover:text-[var(--accent)]"
                >
                    {isEnglish ? "History" : "História"}
                </a>
                <a
                    href="#legacy"
                    class="transition-colors hover:text-[var(--accent)]"
                >
                    {isEnglish ? "Legacy" : "Odkaz"}
                </a>
            </div>

            <div
                class="flex items-center gap-1 rounded-full border border-[var(--text)]/10 p-1 text-xs font-semibold"
            >
                <a
                    href={skUrl}
                    aria-current={!isEnglish ? "page" : undefined}
                    class:list={[
                        "rounded-full px-2.5 py-1.5 transition-colors",
                        !isEnglish
                            ? "bg-[var(--surface)] text-[var(--accent)]"
                            : "opacity-60 hover:opacity-100",
                    ]}
                >
                    SK
                </a>
                <a
                    href={enUrl}
                    aria-current={isEnglish ? "page" : undefined}
                    class:list={[
                        "rounded-full px-2.5 py-1.5 transition-colors",
                        isEnglish
                            ? "bg-[var(--surface)] text-[var(--accent)]"
                            : "opacity-60 hover:opacity-100",
                    ]}
                >
                    EN
                </a>
            </div>

            <ThemeSwitcher client:load lang={lang} />
        </nav>
    </Container>
</header>
