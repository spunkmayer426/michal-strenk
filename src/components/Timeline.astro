---
import Container from "./Container.astro";
import TimelineItem from "./timeline/TimelineItem.astro";

import { timelineContent, timelineEvents, type Lang } from "../data/timeline";

interface Props {
    lang?: Lang;
}

const { lang = "sk" } = Astro.props;
---

<section
    id="history"
    class="scroll-mt-20 bg-[var(--surface)] py-24 md:py-32"
    aria-labelledby="timeline-title"
>
    <Container>
        <!-- Section header -->
        <header class="mb-20 max-w-3xl">
            <p
                class="mb-5 text-xs font-bold uppercase tracking-[0.3em] text-[var(--accent)]"
            >
                {timelineContent.eyebrow[lang]}
            </p>

            <h2
                id="timeline-title"
                class="text-4xl font-semibold tracking-tight md:text-5xl lg:text-6xl"
            >
                {timelineContent.title[lang]}
            </h2>

            <p class="mt-6 text-lg leading-8 opacity-75">
                {timelineContent.subtitle[lang]}
            </p>
        </header>

        <!-- Timeline events -->
        <ol class="relative ml-2 border-l border-[var(--accent)]/30 md:ml-4">
            {
                timelineEvents.map((event, index) => (
                    <TimelineItem
                        event={event}
                        lang={lang}
                        reversed={index % 2 !== 0}
                    />
                ))
            }
        </ol>
    </Container>
</section>
