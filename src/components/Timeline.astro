---
import Container from "./Container.astro";

interface Props {
    lang?: "sk" | "en";
}

const { lang = "sk" } = Astro.props;
const isEnglish = lang === "en";

const content = {
    eyebrow: isEnglish ? "02 / TIMELINE" : "02 / ČASOVÁ OS",
    title: isEnglish ? "A life in moments." : "Život v okamihových míľnikoch.",
    subtitle: isEnglish
        ? "From his childhood in Europe to the Pacific battlefields of the Second World War."
        : "Od detstva v Európe až po bojiská druhej svetovej vojny v Tichomorí.",
};

const events = isEnglish
    ? [
          {
              year: "1919",
              title: "Birth in Europe",
              description:
                  "Michael Strank was born on November 10, 1919, in the village of Jarabina, in present-day Slovakia.",
          },
          {
              year: "1922",
              title: "A new life in America",
              description:
                  "As a young child, he joined his family in the United States and grew up in Pennsylvania.",
          },
          {
              year: "1939",
              title: "Joining the Marine Corps",
              description:
                  "Strank enlisted in the United States Marine Corps, beginning his military career.",
          },
          {
              year: "1945",
              title: "Iwo Jima",
              description:
                  "On February 23, he helped raise the American flag on Mount Suribachi. He was killed in action on March 1.",
          },
      ]
    : [
          {
              year: "1919",
              title: "Narodenie v Európe",
              description:
                  "Michal Strenk sa narodil 10. novembra 1919 v obci Jarabina na území dnešného Slovenska.",
          },
          {
              year: "1922",
              title: "Nový život v Amerike",
              description:
                  "Ako malé dieťa sa pripojil k rodine v Spojených štátoch a vyrastal v Pensylvánii.",
          },
          {
              year: "1939",
              title: "Vstup do námornej pechoty",
              description:
                  "Strenk vstúpil do americkej námornej pechoty a začal svoju vojenskú kariéru.",
          },
          {
              year: "1945",
              title: "Iwodžima",
              description:
                  "Dňa 23. februára pomáhal vztýčiť americkú vlajku na hore Suribači. Dňa 1. marca padol v boji.",
          },
      ];
---

<section
    id="history"
    class="scroll-mt-20 bg-[var(--surface)] py-24 md:py-32"
    aria-labelledby="timeline-title"
>
    <Container>
        <div class="mb-16 max-w-3xl">
            <p
                class="mb-5 text-xs font-bold uppercase tracking-[0.3em] text-[var(--accent)]"
            >
                {content.eyebrow}
            </p>

            <h2
                id="timeline-title"
                class="text-4xl font-semibold tracking-tight md:text-5xl lg:text-6xl"
            >
                {content.title}
            </h2>

            <p class="mt-6 text-lg leading-relaxed opacity-75">
                {content.subtitle}
            </p>
        </div>

        <ol class="relative ml-3 border-l border-[var(--accent)]/40">
            {
                events.map((event, index) => (
                    <li class="relative pb-14 pl-10 last:pb-0 md:pl-16">
                        <span
                            class="absolute -left-[7px] top-2 h-[13px] w-[13px] rounded-full border-[3px] border-[var(--surface)] bg-[var(--accent)]"
                            aria-hidden="true"
                        />

                        <div class="grid gap-4 md:grid-cols-[160px_1fr] md:gap-10">
                            <span class="text-3xl font-semibold tracking-tight text-[var(--accent)] md:text-4xl">
                                {event.year}
                            </span>

                            <div class="max-w-2xl">
                                <h3 class="text-xl font-semibold md:text-2xl">
                                    {event.title}
                                </h3>

                                <p class="mt-3 text-base leading-8 opacity-75">
                                    {event.description}
                                </p>
                            </div>
                        </div>
                    </li>
                ))
            }
        </ol>
    </Container>
</section>
