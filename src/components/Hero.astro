---
import Container from "./Container.astro";

interface Props {
    lang?: "sk" | "en";
}

const { lang = "sk" } = Astro.props;
const isEnglish = lang === "en";

const content = {
    eyebrow: isEnglish
        ? "1919 — 1945 · A LIFE OF SERVICE"
        : "1919 — 1945 · ŽIVOT V SLUŽBE",

    title: isEnglish ? "Michael Strank" : "Michal Strenk",

    description: isEnglish
        ? "A Marine of Slovak origin whose courage became part of one of the most iconic moments of the Second World War."
        : "Americký mariňák slovenského pôvodu, ktorého odvaha sa stala súčasťou jedného z najikonickejších momentov druhej svetovej vojny.",

    button: isEnglish ? "Discover his story" : "Spoznajte jeho príbeh",
};
---

<section
    class="relative isolate flex md:min-h-[85svh] min-h-[45svh] items-end overflow-hidden bg-[#151b18] text-white"
    aria-labelledby="hero-title"
>
    <!-- Desktop background: above 1050px -->
    <div
        class="absolute inset-0 -z-20 hidden bg-cover bg-center min-[1051px]:block"
        style={`background-image: url('${import.meta.env.BASE_URL}images/hero.jpg')`}
    >
    </div>

    <!-- Mobile and tablet background: 1050px and below -->
    <div
        class="absolute inset-0 -z-20 bg-cover bg-center min-[1051px]:hidden"
        style={`background-image: url('${import.meta.env.BASE_URL}images/hero-mobile.jpg')`}
    >
    </div>s

    <!-- Dark overlay for text readability -->
    <div
        class="absolute inset-0 -z-10 bg-gradient-to-t from-black/90 via-black/45 to-black/20"
    >
    </div>

    <Container class="pb-20 pt-40 md:pb-28">
        <div class="max-w-3xl">
            <p
                class="mb-6 text-xs font-semibold uppercase tracking-[0.3em] text-amber-200 md:text-sm"
            >
                {content.eyebrow}
            </p>

            <h1
                id="hero-title"
                class="text-6xl font-bold leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl"
            >
                {content.title}
            </h1>

            <p
                class="mt-8 max-w-2xl text-lg leading-relaxed text-white/85 md:text-xl"
            >
                {content.description}
            </p>

            <a
                href="#story"
                class="mt-10 inline-flex items-center gap-3 rounded-full border border-white/30 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur-sm transition-colors hover:bg-white/20"
            >
                {content.button}
                <span aria-hidden="true">↗</span>
            </a>
        </div>
    </Container>
</section>
