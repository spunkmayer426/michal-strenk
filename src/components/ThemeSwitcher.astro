---
interface Props {
    lang?: "sk" | "en";
}

const { lang = "sk" } = Astro.props;

const labels =
    lang === "sk"
        ? { title: "Vzhľad", system: "Systém", light: "Svetlá", dark: "Tmavá" }
        : { title: "Theme", system: "System", light: "Light", dark: "Dark" };
---

<label class="inline-flex items-center gap-2 text-sm">
    <span>{labels.title}</span>

    <select
        data-theme-switcher
        aria-label={labels.title}
        class="rounded-lg border border-[var(--text)]/20 bg-[var(--surface)] px-3 py-2 text-[var(--text)]"
    >
        <option value="system">{labels.system}</option>
        <option value="light">{labels.light}</option>
        <option value="dark">{labels.dark}</option>
    </select>
</label>

<script>
    const switcher = document.querySelector<HTMLSelectElement>(
        "[data-theme-switcher]",
    );

    if (switcher) {
        let savedTheme = "system";

        try {
            savedTheme = localStorage.getItem("theme") ?? "system";
        } catch {}

        if (!["system", "light", "dark"].includes(savedTheme)) {
            savedTheme = "system";
        }

        switcher.value = savedTheme;

        switcher.addEventListener("change", () => {
            const theme = switcher.value;

            if (theme === "system") {
                delete document.documentElement.dataset.theme;
            } else {
                document.documentElement.dataset.theme = theme;
            }

            try {
                localStorage.setItem("theme", theme);
            } catch {}
        });
    }
</script>
